{
  "name": "blog",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:browser": "ng test",
    "test:all": "npm test -- --watch=false && npm run test:builders && npm test --prefix schematics",
    "test:builders": "npm run build:builders && node builders/test/integration.mjs",
    "test:prerender": "node test/prerender.integration.mjs",
    "test:server": "node test/server.integration.mjs",
    "verify": "npm run lint && npm run test:all && npm run build:deploy && npm run test:prerender && npm run test:server",
    "postinstall": "npm run build:builders && npm run build:schematics",
    "generate-post": "ng g @wellwind/blog-schematics:generate-post",
    "build:builders": "cd builders && npm run build",
    "build:schematics": "cd schematics && npm run build",
    "build:blog-posts-json": "ng run blog:generate-blog-posts-json",
    "build:urls": "ng run blog:generate-prerender-urls",
    "build:rss": "ng run blog:generate-rss",
    "build:minify-html": "ng run blog:minify-rendered-files",
    "build:deploy": "npm run build:blog-posts-json && npm run build:urls && npm run build && npm run build:rss -- --rss-path ./dist/blog/browser/browser/atom.xml && shx mv ./dist/blog/browser/browser/index.csr.html ./dist/blog/browser/browser/index.html",
    "lint": "ng lint",
    "analyze": "ng build --stats-json --named-chunks && npx -y @angular-experts/hawkeye dist/blog/browser/stats.json"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/material": "^22.0.6",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-server": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/ssr": "^22.0.8",
    "@grafana/faro-web-sdk": "^1.13.3",
    "@grafana/faro-web-tracing": "^1.14.3",
    "@wellwind/blog-builder": "file:builders",
    "@wellwind/blog-schematics": "file:schematics",
    "express": "^4.22.2",
    "feed": "^4.2.2",
    "highlight.js": "^11.9.0",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^4.3.0",
    "marked": "^9.1.6",
    "marked-highlight": "^2.0.6",
    "ramda": "^0.30.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.13",
    "@types/js-yaml": "^4.0.3",
    "@types/node": "^22.20.1",
    "@types/puppeteer": "^5.4.4",
    "@types/ramda": "^0.30.0",
    "angular-eslint": "^22.1.0",
    "autoprefixer": "^10.4.12",
    "concurrently": "^6.3.0",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.17",
    "prettier": "^3.4.2",
    "shx": "^0.4.0",
    "tailwindcss": "^3.1.8",
    "ts-node": "^10.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
